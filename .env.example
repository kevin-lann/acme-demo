# Postgres + Redis (docker compose up -d starts both with these defaults)
DATABASE_URL=postgresql://acme:acme@localhost:5432/acme?schema=public
REDIS_URL=redis://localhost:6379

# NextAuth: any long random string works locally (openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me-with-a-random-string

# Stripe test mode (optional). Leave blank to use the built-in simulated payment step.
STRIPE_SECRET_KEY=
